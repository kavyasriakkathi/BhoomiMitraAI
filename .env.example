# ==============================================================================
# BhoomiMitra AI — Production & Development Environment Configuration
# ==============================================================================
# Copy this template to `.env` and configure your environment-specific values.
# IMPORTANT: NEVER commit `.env` or real API keys/credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=bhoomimitra-ai
# Set to "production" in live deployment (enforces strict credential validation)
# Set to "development" or "testing" for local development
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHING (REQUIRED)
# ------------------------------------------------------------------------------
# SQLite (Local Dev): sqlite+aiosqlite:///./dev.db
# PostgreSQL (Production): postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Redis connection URL for caching and state management
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. WHATSAPP CLOUD API (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Meta Developer Portal > WhatsApp App > Configuration
WHATSAPP_VERIFY_TOKEN=your_meta_webhook_verify_token_here
WHATSAPP_API_TOKEN=your_meta_system_user_permanent_access_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_sha256_verification_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id_here
WHATSAPP_API_TIMEOUT_SECONDS=15.0
MAX_MEDIA_DOWNLOAD_BYTES=15728640

# ------------------------------------------------------------------------------
# 4. AI & GEMINI CONFIGURATION (OPTIONAL / FALLBACK-ENABLED)
# ------------------------------------------------------------------------------
# If Gemini is unconfigured or unavailable, specialized modules (Weather, Market,
# Schemes, Shops) continue and return localized fallback guidance.
GOOGLE_GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_TIMEOUT_SECONDS=5.0
AI_CONFIDENCE_THRESHOLD=0.75
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. SPEECH-TO-TEXT / GOOGLE CLOUD (OPTIONAL / FALLBACK-ENABLED)
# ------------------------------------------------------------------------------
# Used for transcribing farmer voice notes in Telugu/Hindi/English
STT_PROVIDER=google
STT_DEFAULT_LANGUAGE=te-IN
STT_API_TIMEOUT_SECONDS=10.0
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# 6. EXTERNAL AGRICULTURAL SERVICES (OPTIONAL / LOCAL DB FALLBACKS)
# ------------------------------------------------------------------------------
# Agmarknet Daily Mandi Prices (data.gov.in)
# OPTIONAL. If empty, uses the authoritative local seeded market database.
DATA_GOV_API_KEY=
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_API_TIMEOUT_SECONDS=5.0
MARKET_PRICE_CACHE_TTL_SECONDS=21600

# OpenWeatherMap 5-Day Forecast
# OPTIONAL. If empty in non-production, provides deterministic weather mocks.
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/forecast
OPENWEATHER_API_TIMEOUT_SECONDS=5.0
WEATHER_CACHE_TTL_SECONDS=1800

# ------------------------------------------------------------------------------
# 7. SECURITY, JWT & RBAC
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=bhoomimitra-ai-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
ADMIN_REGISTRATION_KEY=your_secure_admin_registration_passkey_here

# ------------------------------------------------------------------------------
# 8. PAYMENTS & ESCALATIONS
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_mock
EXPERT_WHATSAPP_GROUP_ID=
ESCALATION_TIMEOUT_MINUTES=30
FOUNDER_ALERT_WEBHOOK_URL=
