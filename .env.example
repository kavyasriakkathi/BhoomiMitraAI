# ============================================
# KrishiMitra AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ---------- App ----------
APP_NAME=krishimitra-ai
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/krishimitra
REDIS_URL=redis://localhost:6379/0

# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_API_TOKEN=your-api-token-here
WHATSAPP_APP_SECRET=your-app-secret-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# ---------- AI / LLM ----------
OPENAI_API_KEY=your-openai-key-here
GOOGLE_GEMINI_API_KEY=your-gemini-key-here
AI_CONFIDENCE_THRESHOLD=0.75

# ---------- Google Cloud (Speech & Translation) ----------
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ---------- Expert Escalation ----------
EXPERT_WHATSAPP_GROUP_ID=your-expert-group-id
ESCALATION_TIMEOUT_MINUTES=30

# ---------- Market Prices (Agmarknet / data.gov.in) ----------
# OPTIONAL. If not set, the feature uses only the local database fallback.
# Register for a free API key at: https://data.gov.in/user/register
DATA_GOV_API_KEY=
